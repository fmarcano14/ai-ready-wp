<?xml version="1.0"?>
<ruleset name="AI Ready WP">
	<description>WordPress coding standards for the AI Ready WP plugin.</description>

	<file>ai-ready-wp.php</file>
	<file>uninstall.php</file>
	<file>src</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="s"/>
	<arg name="colors"/>

	<config name="minimum_supported_wp_version" value="5.8"/>
	<config name="testVersion" value="7.4-"/>

	<!-- Core style and security. Docs sniffs want a docblock on every getter, which this plugin does not use. -->
	<rule ref="WordPress-Core"/>
	<rule ref="WordPress.Security.EscapeOutput"/>
	<rule ref="WordPress.Security.NonceVerification"/>
	<rule ref="WordPress.Security.ValidatedSanitizedInput"/>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="ai_ready"/>
				<element value="AI_READY"/>
				<element value="AiReady"/>
			</property>
		</properties>
	</rule>

	<!-- PSR-4 file names match the class. WPCS hyphenated names fight the autoloader. -->
	<rule ref="WordPress.Files.FileName">
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
	</rule>

	<!-- Generated files are local. Remote HTTP helpers are the wrong tool. -->
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>src/Store.php</exclude-pattern>
	</rule>

	<!-- DOMDocument property names are fixed by PHP. -->
	<rule ref="WordPress.NamingConventions.ValidVariableName.UsedPropertyNotSnakeCase">
		<exclude-pattern>src/HtmlToMarkdown.php</exclude-pattern>
	</rule>
</ruleset>
