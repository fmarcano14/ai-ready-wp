{
	"name": "fmarcano14/ai-ready-wp",
	"description": "Single-site WordPress plugin that publishes llms.txt and Markdown views of public content.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4",
		"ext-mbstring": "*"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpunit/phpunit": "^9.6",
		"squizlabs/php_codesniffer": "^3.7",
		"wp-coding-standards/wpcs": "^3.1",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"autoload": {
		"psr-4": {
			"AiReady\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"AiReady\\Tests\\": "tests/unit/"
		}
	},
	"scripts": {
		"lint": "phpcs",
		"test": "phpunit --testsuite unit",
		"test:wp": "phpunit --testsuite integration"
	},
	"config": {
		"sort-packages": true,
		"platform": {
			"php": "7.4.33"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
